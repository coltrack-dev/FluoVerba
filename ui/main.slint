import { ComboBox, Slider } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "FluoVerba";
    preferred-width: 900px;
    preferred-height: 370px;
    background: transparent;

    in-out property <string> spanish: "";
    in-out property <string> russian: "";
    in-out property <float> progress: 0;
    in-out property <bool> snap-progress: false;
    out property <length> travel-distance: root.width + ticker_rail.width;
    out property <length> effective-belt-y: max(0px, min(root.height - ticker_rail.height, root.belt-y));
    in-out property <float> speed: 20;
    in-out property <length> belt-y: 0px;
    in-out property <bool> settings-open: false;
    in-out property <bool> keep-screen-on: false;
    in-out property <bool> speech-enabled: false;
    in-out property <float> speech-rate: 1.0;
    in-out property <string> speech-language: "es-ES";
    in-out property <bool> russian-translation-enabled: true;
    in-out property <float> russian-volume: 0.75;
    in-out property <string> russian-voice: "";
    in-out property <[string]> russian-voices: [];
    in-out property <string> russian-voice-status: "Загрузка локальных голосов ru-RU…";
    in-out property <bool> russian-voice-available: false;
    in-out property <bool> drag-active: false;
    in-out property <length> drag-offset: 0px;
    callback toggle-settings-requested();
    callback speed-changed(float);
    callback keep-screen-changed(bool);
    callback speech-enabled-changed(bool);
    callback test-voice-requested();
    callback speech-rate-changed(float);
    callback speech-language-changed(string);
    callback russian-translation-changed(bool);
    callback russian-volume-changed(float);
    callback russian-voice-changed(string);
    callback test-russian-voice-requested();
    callback belt-position-saved(length);

    animate progress { duration: root.snap-progress ? 0ms : 16ms; easing: linear; }

    TouchArea {
        width: root.width;
        height: root.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-active = self.mouse-y >= root.effective-belt-y && self.mouse-y <= root.effective-belt-y + ticker_rail.height;
                root.drag-offset = self.mouse-y - root.effective-belt-y;
            } else if (event.kind == PointerEventKind.move && root.drag-active) {
                root.belt-y = max(0px, min(root.height - ticker_rail.height, self.mouse-y - root.drag-offset));
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.drag-active) {
                    root.belt-position-saved(root.effective-belt-y);
                }
                root.drag-active = false;
            }
        }
    }

    Rectangle {
        background: #14202c;
        width: parent.width;
        height: ticker_rail.height;
        y: root.effective-belt-y;

        // One content-sized rail and one x coordinate keep both lines aligned.
        ticker_rail := Rectangle {
            x: root.width - root.progress * root.travel-distance;
            y: 0px;
            width: max(spanish_label.preferred-width, russian_label.preferred-width);
            height: 6px + spanish_label.preferred-height + 4px + russian_label.preferred-height + 6px;
            background: transparent;
            spanish_label := Text {
                text: root.spanish;
                color: #f1f5f9;
                font-size: 1.285714rem;
                vertical-alignment: center;
                x: 0px;
                y: 6px;
                width: self.preferred-width;
                height: self.preferred-height;
            }
            russian_label := Text {
                text: root.russian;
                color: #9be7c4;
                font-size: 1.142857rem;
                vertical-alignment: center;
                x: 0px;
                y: 6px + spanish_label.preferred-height + 4px;
                width: self.preferred-width;
                height: self.preferred-height;
            }
        }

        Rectangle {
            x: parent.width - 38px;
            y: 4px;
            width: 34px;
            height: 24px;
            border-radius: 6px;
            background: #263848;
            Text { text: "⋮"; color: #f1f5f9; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.toggle-settings-requested(); } }
        }
    }

    if root.settings-open: Rectangle {
        x: 8px;
        y: max(0px, min(root.height - 318px, root.effective-belt-y + ticker_rail.height + 4px));
        width: min(root.width - 16px, 320px);
        height: 310px;
        border-radius: 8px;
        background: #263848;
        Text { x: 10px; y: 5px; text: "Scroll: " + round(root.speed) + " dp/s"; color: #f1f5f9; font-size: 13px; }
        Slider {
            x: 10px;
            y: 22px;
            width: parent.width - 20px;
            minimum: 5;
            maximum: 120;
            value: root.speed;
            changed(value) => { root.speed = value; root.speed-changed(value); }
        }
        Rectangle {
            x: 10px; y: 47px; width: parent.width - 20px; height: 25px;
            background: transparent;
            Text { text: root.keep-screen-on ? "Keep screen on: ON" : "Keep screen on: OFF"; color: #f1f5f9; font-size: 14px; vertical-alignment: center; }
            TouchArea {
                clicked => {
                    root.keep-screen-on = !root.keep-screen-on;
                    root.keep-screen-changed(root.keep-screen-on);
                }
            }
        }
        Rectangle {
            x: 10px; y: 73px; width: 132px; height: 26px;
            background: transparent;
            Text { text: root.speech-enabled ? "Озвучка фраз: ВКЛ" : "Озвучка фраз: ВЫКЛ"; color: #f1f5f9; font-size: 14px; vertical-alignment: center; }
            TouchArea { width: parent.width;
                clicked => {
                    root.speech-enabled = !root.speech-enabled;
                    root.speech-enabled-changed(root.speech-enabled);
                }
            }
        }
        Rectangle {
            x: 148px; y: 73px; width: parent.width - 158px; height: 26px;
            border-radius: 4px;
            background: #344f5e;
            Text { text: "Тест ES"; color: #f1f5f9; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.test-voice-requested(); } }
        }
        ComboBox {
            x: 10px; y: 101px; width: parent.width - 20px; height: 28px;
            model: ["es-ES", "es-CO", "es-MX"];
            current-value: root.speech-language;
            selected => { root.speech-language-changed(self.current-value); }
        }
        Rectangle {
            x: 10px; y: 133px; width: 132px; height: 26px;
            background: transparent;
            Text { text: root.russian-translation-enabled ? "Русский перевод: ВКЛ" : "Русский перевод: ВЫКЛ"; color: #f1f5f9; font-size: 13px; vertical-alignment: center; }
            TouchArea { width: parent.width;
                clicked => {
                    root.russian-translation-enabled = !root.russian-translation-enabled;
                    root.russian-translation-changed(root.russian-translation-enabled);
                }
            }
        }
        Rectangle {
            x: 148px; y: 133px; width: parent.width - 158px; height: 26px;
            border-radius: 4px;
            background: root.russian-voice-available ? #344f5e : #39434a;
            Text { text: "Проверить голос"; color: #f1f5f9; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { enabled: root.russian-voice-available; clicked => { root.test-russian-voice-requested(); } }
        }
        ComboBox {
            x: 10px; y: 163px; width: parent.width - 20px; height: 28px;
            model: root.russian-voices;
            current-value: root.russian-voice;
            enabled: root.russian-voice-available;
            selected => { root.russian-voice-changed(self.current-value); }
        }
        Text { x: 10px; y: 193px; text: "Громкость RU: " + round(root.russian-volume * 100) + "%"; color: #f1f5f9; font-size: 13px; }
        Slider {
            x: 10px; y: 211px; width: parent.width - 20px;
            minimum: 0.3; maximum: 1.0; value: root.russian-volume;
            changed(value) => { root.russian-volume = value; root.russian-volume-changed(value); }
        }
        Text { x: 10px; y: 237px; text: "Speech rate: " + round(root.speech-rate * 100) / 100 + "x"; color: #f1f5f9; font-size: 13px; }
        Slider {
            x: 10px; y: 255px; width: parent.width - 20px;
            minimum: 0.5; maximum: 1.5; value: root.speech-rate;
            changed(value) => { root.speech-rate = value; root.speech-rate-changed(value); }
        }
        Text {
            x: 10px; y: 281px; width: parent.width - 20px; height: 24px;
            text: root.russian-voice-status;
            color: root.russian-voice-available ? #9be7c4 : #f2c879; font-size: 11px;
        }
    }
}
